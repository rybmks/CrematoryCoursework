<Window x:Class="Crematory.Views.UserInterface.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crematory.Views.UserInterface"
        mc:Ignorable="d"
        Title="StatisticsWindow" Height="450" Width="800">
    <Grid Background="#FFD580">
        <TabControl HorizontalAlignment="Left"
                    Height="261"
                    Margin="10 10 0 0"
                    VerticalAlignment="Top"
                    Width="455">
            <TabItem Header="Найпопулярніші сервіси">
                <Grid Background="#FFE5E5E5">
                    <DataGrid x:Name="servicesDataGrid" AutoGenerateColumns="True" Margin="0,0,-299,-147" />
                </Grid>
            </TabItem>
            <TabItem Header="Інша вкладка">
                <DataGrid x:Name="servicesDataGrid2" AutoGenerateColumns="True" Margin="0,0,-299,-147" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
